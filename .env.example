# Copy this file to `.env` and fill in your own values. Never commit real values.
#
# Variables prefixed with VITE_ are inlined into the public browser bundle by Vite.
# Only use the VITE_ prefix for values that are safe to be public.

# --- Server-side only (used by Netlify Functions, never shipped to the browser) ---
# Gemini AI API Key - Get from https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here
# GitHub personal access token used to raise API rate limits
GITHUB_API_TOKEN=your_github_token_here
# GitHub OAuth app secret
GITHUB_CLIENT_SECRET=your_github_client_secret_here
# Google OAuth client secret
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Google Sheets API
GOOGLE_SHEET_ID=your_google_sheet_id_here

# --- Public (safe to expose in the browser bundle) ---
# Google Calendar OAuth client (client ID is public by design)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback

# Backend API
VITE_API_URL=http://localhost:5000
